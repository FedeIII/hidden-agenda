{
	"name": "hidden-agenda",
	"version": "2.1.1",
	"main": "src/index.js",
	"homepage": "https://fedeiii.github.io/hidden-agenda/",
	"scripts": {
		"go": "vite --open",
		"do": "vite build",
		"dev": "vite --open",
		"build": "vite build",
		"serve": "vite preview",
		"test": "jest",
		"test:unit": "jest --selectProjects unit",
		"test:e2e": "jest --selectProjects e2e",
		"smoke": "jest src/tests/smoke.test.js",
		"predeploy": "npm run do",
		"deploy": "gh-pages -d docs"
	},
	"devDependencies": {
		"@babel/core": "^7.5.5",
		"@babel/preset-env": "^7.5.5",
		"@babel/preset-react": "^7.0.0",
		"babel-eslint": "^10.0.2",
		"babel-plugin-styled-components": "^1.10.6",
		"eslint": "^6.1.0",
		"eslint-config-react-app": "^4.0.1",
		"eslint-plugin-import": "^2.18.2",
		"eslint-plugin-jsx-a11y": "^6.2.3",
		"eslint-plugin-react": "^7.14.3",
		"eslint-plugin-react-hooks": "^1.6.1",
		"gh-pages": "^3.1.0",
		"polished": "^3.4.1",
		"prettier": "^1.18.2",
		"styled-components": "^4.3.2",
		"vite": "^8.2.0"
	},
	"dependencies": {
		"babel-polyfill": "^6.26.0",
		"jest": "^26.6.3",
		"puppeteer": "^8.0.0",
		"react": "^16.8.6",
		"react-dnd": "^14.0.2",
		"react-dnd-html5-backend": "^14.0.0",
		"react-dom": "^16.8.6"
	},
	"author": "Federico Perez <fedelll@gmail.com>",
	"jest": {
		"maxWorkers": "50%",
		"projects": [
			{
				"displayName": "unit",
				"testEnvironment": "node",
				"testMatch": [
					"<rootDir>/src/tests/unit/**/*.test.js"
				],
				"moduleNameMapper": {
					"Domain/(.*)": "<rootDir>/src/domain/$1"
				}
			},
			{
				"displayName": "e2e",
				"testMatch": [
					"<rootDir>/src/tests/*.test.js"
				],
				"setupFiles": [
					"<rootDir>/jest.init.js"
				],
				"setupFilesAfterEnv": [
					"<rootDir>/src/tests/helpers/setupTests.js"
				],
				"moduleNameMapper": {
					"Domain/(.*)": "<rootDir>/src/domain/$1"
				}
			}
		]
	}
}
